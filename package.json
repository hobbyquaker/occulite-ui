{
  "name": "occulite-ui",
  "version": "0.1.0",
  "description": "Svelte 5 UI kit with openccu-lite's look: design tokens, light and dark themes, de/en handling, DataTable, dialogs, menus, notices",
  "license": "MIT",
  "author": "Sebastian 'hobbyquaker' Raff <hobbyquaker@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/occulite-ui.git"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/occulite-ui/issues"
  },
  "homepage": "https://github.com/hobbyquaker/occulite-ui#readme",
  "keywords": [
    "svelte",
    "svelte5",
    "ui",
    "components",
    "design-tokens",
    "datatable",
    "homematic",
    "openccu-lite"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "svelte": "./dist/table/index.js",
      "default": "./dist/table/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "svelte": "./dist/i18n/index.js",
      "default": "./dist/i18n/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "svelte": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./embedding": {
      "types": "./dist/embedding/index.d.ts",
      "svelte": "./dist/embedding/index.js",
      "default": "./dist/embedding/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "svelte": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    },
    "./notices": {
      "types": "./dist/notices/index.d.ts",
      "svelte": "./dist/notices/index.js",
      "default": "./dist/notices/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "default": "./dist/clipboard.js"
    },
    "./app.css": "./dist/css/app.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./base.css": "./dist/css/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "prepack": "npm run build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:jsdom": "vitest run --config ./vitest.jsdom.config.ts",
    "publint": "publint --strict",
    "pack:check": "node scripts/pack-check.mjs",
    "size": "node scripts/size-report.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.40.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.4.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "~1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
